# Los datos (check-ins, PINs, contenido) se guardan como archivos JSON en un repo de
# GitHub aparte, no en una base de datos con cuota medida. Ver README para cómo crear
# el token.
GITHUB_DATA_TOKEN=
DATA_REPO_OWNER=
DATA_REPO_NAME=
DATA_REPO_BRANCH=data-store

# Cualquier cadena larga al azar — firma las sesiones de login. Genérala una vez y no la cambies
# (cambiarla invalida todas las sesiones activas).
AUTH_SECRET=

# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=

# Cadena al azar que vos eliges; se usa al registrar el webhook (setWebhook) y el handler
# la valida en cada request entrante para confirmar que de verdad viene de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Cadena al azar que vos eliges; Vercel Cron la manda automáticamente como Bearer token
# cuando la configuras como variable de entorno del proyecto.
CRON_SECRET=
